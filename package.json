{
  "name": "restock-monitor",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Watches Walmart product pages and alerts on out-of-stock to in-stock transitions.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "once": "node src/index.ts --once",
    "selftest": "node src/index.ts --selftest",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "find": "node src/find.ts"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
