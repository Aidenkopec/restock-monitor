# Discord webhook. Leave unset and alerts print to the console instead.
# Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Optional overrides
# POLL_INTERVAL_MS=45000

# debug | info | warn | error | silent
# A real environment variable beats this file, so under pm2 set LOG_LEVEL in
# ecosystem.config.cjs -- the value here is ignored in that case.
# LOG_LEVEL=info
